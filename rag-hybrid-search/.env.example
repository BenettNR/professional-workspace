# ── Required ──────────────────────────────────────────────────────────────────
# Voyage AI — used for embeddings (voyage-3, Anthropic's recommended partner)
# Get your key at: dash.voyageai.com
VOYAGE_API_KEY=pa-...

# Anthropic — used for Claude Sonnet generation and LLM-as-judge verification
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# EMBEDDING_MODEL=voyage-3    # voyage-3 | voyage-3-lite | voyage-code-3
# LLM_MODEL=claude-sonnet-4-6
# LLM_MAX_TOKENS=2048

# CHROMA_PERSIST_DIRECTORY=data/chroma
# CHROMA_COLLECTION_NAME=rag_documents
# BM25_INDEX_PATH=data/bm25_index.pkl

# DENSE_TOP_K=10
# SPARSE_TOP_K=10
# FUSION_TOP_K=20
# RERANK_TOP_K=5
# RRF_K=60
# DENSE_WEIGHT=0.7
# SPARSE_WEIGHT=0.3
# DEDUP_SIMILARITY_THRESHOLD=0.95

# DEFAULT_CHUNK_STRATEGY=recursive    # fixed | recursive | semantic
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# SEMANTIC_BREAKPOINT_THRESHOLD=0.3

# RETRIEVAL_CONFIDENCE_THRESHOLD=0.3

# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# USE_LLM_RERANKER=false

# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false
